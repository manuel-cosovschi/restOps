# ============================================================
# RestOps · Variables de entorno
# Copiar a .env.local y completar. NUNCA commitear .env.local
# ============================================================

# --- Supabase ---------------------------------------------------
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://dfbxrytiigwczxhfsvzc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO servidor. Bypassea RLS entera.
# Jamas con prefijo NEXT_PUBLIC_. Jamas en un route handler de usuario.
SUPABASE_SERVICE_ROLE_KEY=

# Para el CLI y la generacion de tipos
SUPABASE_PROJECT_ID=dfbxrytiigwczxhfsvzc
SUPABASE_DB_PASSWORD=

# --- App --------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=es-AR
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires

# --- Notificaciones (Sprint 7) ----------------------------------
# Web Push: generar con `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@restops.app

# Email
RESEND_API_KEY=
EMAIL_FROM=RestOps <no-reply@restops.app>

# --- WhatsApp (v1.1, no usar en v1) -----------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- Billing (Sprint 8) -----------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Observabilidad ---------------------------------------------
SENTRY_DSN=
